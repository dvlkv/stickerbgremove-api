# Use NVIDIA CUDA base image with cuDNN (latest supported by PyTorch 2.7.1)
FROM nvidia/cuda:12.8.0-cudnn-runtime-ubuntu22.04

ENV DEBIAN_FRONTEND=noninteractive

# Install system dependencies
RUN apt-get update && apt-get install -y --no-install-recommends \
    python3-pip python3-dev python3-opencv libglib2.0-0 libgl1 ffmpeg build-essential \
    && rm -rf /var/lib/apt/lists/*

# Upgrade pip
RUN python3 -m pip install --upgrade pip

WORKDIR /app

# Copy requirements and install Python dependencies (excluding torch, torchvision, onnxruntime)
COPY requirements.txt ./

# Install CUDA-enabled PyTorch, torchvision, torchaudio
RUN pip install torch==2.7.1+cu128 torchvision==0.22.1+cu128 torchaudio --extra-index-url https://download.pytorch.org/whl/cu128

# Install ONNXRuntime with GPU support
RUN pip install onnxruntime-gpu==1.22.0

# Install the rest of the dependencies, ignoring torch, torchvision, onnxruntime if present
RUN pip install --no-cache-dir --ignore-installed torch --ignore-installed torchvision --ignore-installed onnxruntime -r requirements.txt

# Copy the rest of the application code and the ONNX model
COPY . .

EXPOSE 8000

# CMD ["uvicorn", "api:app", "--host", "0.0.0.0", "--port", "8000"]
CMD ["python", "-u", "runpod_worker.py"]
